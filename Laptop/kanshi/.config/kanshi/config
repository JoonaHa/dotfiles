profile default {
    output eDP-1 mode 1920x1080@60.049Hz
}

profile HDMI {
    output eDP-1 mode 1920x1080@60.049Hz position 0,1440
    output HDMI-A-1 mode 2560x1440@59.951Hz position 0,0
    #output HDMI-A-1 mode 3840x2160@30.000Hz position 0,2160
    exec swaymsg workspace 1, move workspace to HDMI-A-1
    exec swaymsg workspace 3, move workspace to HDMI-A-1
    exec swaymsg workspace 5, move workspace to HDMI-A-1
    exec swaymsg workspace 7, move workspace to HDMI-A-1
    exec swaymsg workspace 9, move workspace to HDMI-A-1

    exec swaymsg workspace 2, move workspace to eDP-1
    exec swaymsg workspace 4, move workspace to eDP-1
    exec swaymsg workspace 6, move workspace to eDP-1
    exec swaymsg workspace 8, move workspace to eDP-1
    exec swaymsg workspace 0, move workspace to eDP-1
}

